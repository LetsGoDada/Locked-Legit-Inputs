
import os
import sys
import subprocess
import tkinter as tk
from tkinter import messagebox
from pathlib import Path

BG = "#0B1424"
PANEL = "#172940"
BLUE = "#72CFFF"
WHITE = "#FFFFFF"
MUTED = "#B7C8DC"


def resource_path(name):
    base = Path(getattr(sys, "_MEIPASS", Path(__file__).parent))
    return base / name


def open_input_proof():
    app = resource_path("LLI-App.exe")
    if not app.is_file():
        messagebox.showerror("LLI", "The input proof app was not found.")
        return
    try:
        subprocess.Popen([str(app)], cwd=str(app.parent))
    except Exception as exc:
        messagebox.showerror("LLI", str(exc))


def open_hash_checker():
    bat = resource_path("SHA-256-proof.bat")
    ps1 = resource_path("SHA-256-proof.ps1")

    if not bat.is_file() or not ps1.is_file():
        messagebox.showerror(
            "LLI", "The SHA-256 checker files were not found."
        )
        return

    try:
        subprocess.Popen(
            ["cmd.exe", "/c", "SHA-256-proof.bat"],
            cwd=str(bat.parent),
            creationflags=subprocess.CREATE_NEW_CONSOLE
        )
    except Exception as exc:
        messagebox.showerror("LLI", str(exc))


root = tk.Tk()
root.title("LLI — Locked Legit Inputs")
root.geometry("520x480")
root.resizable(False, False)
root.configure(bg=BG)

try:
    root.iconbitmap(resource_path("LLI_logo.ico"))
except Exception:
    pass

header = tk.Frame(root, bg=BG)
header.pack(pady=(28, 8))

tk.Label(
    header, text="⚓", font=("Segoe UI Symbol", 35),
    fg=BLUE, bg=BG
).pack()

tk.Label(
    root, text="LLI", font=("Segoe UI", 30, "bold"),
    fg=WHITE, bg=BG
).pack()

tk.Label(
    root, text="LOCKED LEGIT INPUTS",
    font=("Segoe UI", 10, "bold"), fg=BLUE, bg=BG
).pack(pady=(0, 8))

tk.Label(
    root, text="Your gameplay input verification toolkit.",
    font=("Segoe UI", 10), fg=MUTED, bg=BG
).pack(pady=(0, 24))


def make_button(title, subtitle, command):
    button = tk.Button(
        root, text=f"{title}\n{subtitle}",
        command=command,
        font=("Segoe UI", 12, "bold"),
        fg=WHITE, bg=PANEL,
        activebackground="#244565",
        activeforeground=WHITE,
        relief="flat", bd=0,
        cursor="hand2",
        justify="left", anchor="w",
        padx=22, pady=15
    )
    button.pack(fill="x", padx=42, pady=7)
    return button


make_button(
    "Input Proof",
    "Record and export keyboard and mouse logs",
    open_input_proof
)

make_button(
    "SHA-256 Checker",
    "Check file hashes using the checker tool",
    open_hash_checker
)

tk.Label(
    root, text="LLI  •  INPUT VERIFICATION TOOLKIT",
    font=("Segoe UI", 8), fg="#8295AD", bg=BG
).pack(side="bottom", pady=18)

root.mainloop()
